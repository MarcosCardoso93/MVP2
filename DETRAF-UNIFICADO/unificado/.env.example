# Configuração dos RPAs do Detraf — copie para `.env` e preencha.
#
# NUNCA comite o `.env` preenchido. Os Projetos 2 e 3 traziam a senha real do
# MySQL de produção no `.env` versionado junto do código; esse padrão não foi
# herdado.
#
# Todas as variáveis são lidas em `comum/config/configuration.py`, o único
# ponto do repositório autorizado a chamar `os.getenv`.

# ===========================================================================
# Ambiente
# ===========================================================================
# dev  -> SQLite local  |  prod -> MySQL
ENV=dev

# DEBUG | INFO | WARNING | ERROR. O Projeto 1 usava DEBUG fixo; o default é INFO.
LOG_LEVEL=INFO

# Raiz dos arquivos de log. Vazia, usa `unificado/logs`.
#
# O caminho final é {RAIZ_LOGS}/{host}/{robô}/{ano}/{mês}/{dia}.log — um arquivo
# por robô, para dar para isolar uma execução. Antes o caminho era relativo ao
# diretório de trabalho, e como cada robô é lançado da sua pasta, existiam três
# árvores de log separadas no disco.
RAIZ_LOGS=

# Por quanto tempo os logs ficam. Eram 7 dias, mas o ciclo do Detraf é mensal:
# uma contestação de julho é questionada em agosto.
LOG_RETENCAO=90 days

# Inclui os VALORES DAS VARIÁVEIS LOCAIS no traceback gravado em arquivo.
#
# ⚠️ Ajuda muito a diagnosticar e, pelo mesmo motivo, grava dado sensível em
# disco — senha de banco, credencial do AGI, conteúdo de e-mail. Vazio, segue o
# ENV: ligado fora de produção, desligado em prod.
LOG_DIAGNOSE=


# ===========================================================================
# Período de referência
# ===========================================================================
# AAAAMM. Se vazio, usa o mês corrente. O robô sempre processa o MÊS ANTERIOR
# a este valor (202606 -> processa 202605).
# `COMPETENCIA` é aceito como sinônimo (era o nome usado no Projeto 1).
DEBUG_ANO_MES_ATUAL=

# Sinônimo do anterior. Se os dois estiverem preenchidos, DEBUG_ANO_MES_ATUAL
# vence. Na homologação, prefira o argumento `--referencia AAAAMM`, que recebe o
# MÊS DE TRÁFEGO e faz a conversão — assim não há a conta de +1 mês para errar.
COMPETENCIA=


# ===========================================================================
# Banco de dados
# ===========================================================================
# Caminho do SQLite, usado quando ENV=dev. Se vazio, usa
# `banco_de_dados/TABELAS_DETRAF.db` relativo ao diretório de execução.
#
# Gere esse banco com `python preparar_banco_dev.py`: ele copia o SQLite do
# Projeto 2 e renomeia a tabela de log para o nome da V2
# (`tbl_rpa_log_detraf_despesa_arquivos`), que é o adotado.
#
# ATENÇÃO: os SQLite que vieram com os projetos usam o nome ANTIGO
# (`tbl_detraf_despesa_arquivos`) e não servem direto.
#
# Para homologar contra dados REAIS sem tocar no WebFat, gere um espelho do
# MySQL com `python espelhar_banco.py` e aponte aqui.
CAMINHO_SQLITE=

# Sinônimo do anterior, aceito para os `.env` dos projetos de origem
# continuarem valendo. `CAMINHO_SQLITE` vence quando os dois existem.
CAMINHO_SQLITE_DEV=

# Credenciais do MySQL — usadas somente quando ENV=prod.
#
# ✅ RESOLVIDO EM 2026-08-06, conectando de verdade. A base `webfat`, com as
# cinco tabelas que o código usa, está em 10.124.66.77.
#
# Não era divergência entre os projetos de origem — era topologia. São dois
# servidores, e cada um tem uma base:
#
#   10.124.66.77  ->  `webfat`   as 5 tabelas do Detraf. É esta que se usa aqui.
#   10.124.66.79  ->  `rpa`      receita/log de outros robôs. NÃO tem `webfat`.
#
# Quem estava certo era o P6/P7, que mantinham as DUAS conexões
# (HOST_BD_RPA=.79/rpa e HOST_BD_WEBFAT=.77/webfat). O P2/P3 apontavam
# `.79/webfat`, que não existe — e foi essa a escolha registrada até aqui.
#
# ⚠️ Duas armadilhas, para quem for reconferir:
#   - o `.79` AUTENTICA com a mesma credencial e só falha ao abrir a base, com
#     "Unknown database 'webfat'" (erro 1049);
#   - os grants do usuário NO `.79` citam `webfat.<as 5 tabelas>` nominalmente.
#     São grants órfãos — o mesmo servidor tem grants para tabelas `mvp2` que
#     também não existem lá. Grant não prova onde o schema está.
#
# O terceiro candidato, 10.126.70.170 (print do Workbench), não responde na 3306.
HOST_BD_RPA=10.124.66.77
PORT_BD_RPA=3306
DATABASE_RPA=webfat
USUARIO_BD=
SENHA_BD=


# ===========================================================================
# Formatos aceitos
# ===========================================================================
EXTENSOES_CSV=csv,txt
# O `.ods` vem dos `.env` de origem (P1, P2, P3) — alguma operadora entrega
# nesse formato.
EXTENSOES_EXCEL=xlsx,xls,ods


# ===========================================================================
# Raiz das operadoras — usada pelos TRÊS RPAs
# ===========================================================================
# "...\Operadoras", que contém:
#   {operadora}\{ano}\{aaaamm}\Detrafs Recebidos   <- RPA 1 grava, RPA 2 lê
#   {operadora}\{ano}\{aaaamm}\Detrafs Enviados
#   {operadora}\{ano}\{aaaamm}\AGI
#   {operadora}\{ano}\{aaaamm}\Contestações
#
# Em produção, o caminho de rede (\\lagoa\DI\DI-A\DI-A1\...\Operadoras).
#
# Esta é a ÚNICA variável para essa pasta. Os projetos de origem usavam três
# nomes diferentes para ela — DIRETORIO_SAIDA (RPA 1), CAMINHO_DETRAF_RECEBIDO
# (RPAs 2 e 3) e CAMINHO_OPERADORAS — e nada garantia que apontassem para o
# mesmo lugar. Se divergissem, o RPA 2 apenas registrava "nenhum arquivo
# encontrado" e seguia, sem erro.
#
# Os nomes antigos ainda são aceitos como fallback, para não quebrar .env
# existentes, mas prefira este.
CAMINHO_OPERADORAS=arquivos/Operadoras


# ===========================================================================
# RPA 1 — captura de arquivos das operadoras
# ===========================================================================
# Pasta local onde os anexos baixados do Outlook são gravados e lidos.
DIRETORIO_ENTRADA=arquivos/Entrada

# Pasta de exceção, para arquivos cuja operadora não foi identificada.
# Precisa ficar FORA de CAMINHO_OPERADORAS: o RPA 2 varre aquela raiz tratando
# todo diretório como uma operadora. Se vazio, usa a pasta irmã
# "_NAO_IDENTIFICADOS".
DIRETORIO_NAO_IDENTIFICADOS=arquivos/_NAO_IDENTIFICADOS

# Pasta de exceção para arquivos REPROVADOS na validação da captura.
# Se vazio, usa a pasta irmã "_QUARENTENA".
#
# É outra coisa que _NAO_IDENTIFICADOS, e a diferença importa para quem
# investiga: lá o arquivo está íntegro e falta cadastro NOSSO; aqui o arquivo é
# que está errado, e a operadora já foi avisada.
#
# Também precisa ficar FORA de CAMINHO_OPERADORAS — e por um motivo a mais: se
# ficasse dentro, o RPA 2 acharia o arquivo reprovado, o validaria de novo e
# responderia à operadora uma SEGUNDA vez.
DIRETORIO_QUARENTENA=arquivos/_QUARENTENA

# Área de trabalho do RPA 2 (2026-08-10). Se vazio, usa a pasta irmã "_TEMP".
#
# A validação de expectativa regrava o arquivo com as linhas que passaram. Se
# nenhuma passar — e basta o banco estar com uma coluna fora do lugar —, o que
# sobra no disco é o cabeçalho, e em produção esse arquivo é o da rede. Por isso
# o robô copia o insumo para cá, escreve na CÓPIA, e devolve à pasta de origem
# só os artefatos (`_ENV`, `_ERRO`, `_BK`, `_RECUSADO.md`).
#
# Também precisa ficar FORA de CAMINHO_OPERADORAS: o RPA 2 varre aquela raiz
# tratando todo diretório como operadora, e acharia as próprias cópias.
#
# É preservada por mês de referência — evidência de homologação, e o estado
# parcial de uma etapa que morreu no meio. Quem limpa é o resetar_homologacao.py.
DIRETORIO_TEMP=arquivos/_TEMP

# Saída da validação do RPA 2 (2026-08-10). Se vazio, usa a pasta irmã "_SAIDA".
#
# Os artefatos (`_ENV`, `_ERRO`, `_BK`, `_RECUSADO.md`) vão para cá em vez de
# ficarem ao lado do insumo. Duas razões:
#
#   1. as pastas de entrada acumulavam entrada e saída misturadas;
#   2. o RPA 3 lista TODO arquivo com extensão válida em `Detrafs Recebidos`,
#      sem filtro de sufixo — o `_BK` e o `_ERRO` deixados ao lado entravam na
#      consolidação e duplicavam linha.
#
# A estrutura é `{aaaamm}/Operadoras/{operadora}/{subpasta}` e
# `{aaaamm}/Expectativa/{pasta}`. `Operadoras` e `Expectativa` são separados
# porque quem varre a raiz trata todo diretório como uma operadora.
#
# ⚠️ É o CONTRATO entre a validação e o batimento: quem grava e quem lê usam a
# mesma função (`estrutura_pastas.caminho_de_saida`). Mudar isto aqui muda os
# dois lados juntos — que é o ponto. Antes desta data cada um derivava o caminho
# por conta própria, eles divergiam, e o batimento nunca achava um Detraf.
#
# Também precisa ficar FORA de CAMINHO_OPERADORAS.
DIRETORIO_SAIDA_VALIDACAO=arquivos/_SAIDA

# --- Notificação da operadora (HU-04) --------------------------------------
# Quem responde à operadora é o RPA 1 desde 2026-08-06: ele valida ANTES de
# salvar o arquivo na pasta que o RPA 2 lê, e o que reprova nunca entra na
# árvore. O RPA 2 continua validando — como rede de segurança — mas não responde
# mais e-mail.
#
# Template do corpo do e-mail de resposta quando um Detraf é reprovado.
# Placeholders aceitos: {arquivos} {quantidade} {assunto_original}
#                       {remetente} {data_recebimento}
#
# A resposta é UMA por e-mail de origem, não por arquivo: um e-mail pode trazer
# vários anexos, e vários podem ser reprovados. {arquivos} é a lista deles, cada
# um com os seus motivos. Sem ela a operadora recebe "seu arquivo está
# inválido" e não tem como corrigir nada.
#
# Se vazio, a notificação é pulada com erro em log — mas o arquivo vai para a
# quarentena do mesmo jeito. O robô não deixa de recusar por falta de template.
#
# ⚠️ O arquivo INTEIRO vira o corpo do e-mail: nada de linhas de comentário, e
# toda chave `{...}` é tratada como placeholder.
#
# Há um modelo genérico em `configuracao/email-detraf-invalido.txt`. Ele foi
# escrito pela equipe técnica e **precisa ser revisado pela área** antes de
# ligar o NOTIFICAR_OPERADORA_ENVIAR — é texto que vai para fora da empresa.
CAMINHO_TEMPLATE_EMAIL_DETRAF_INVALIDO=configuracao/email-detraf-invalido.txt

# false -> apenas CRIA O RASCUNHO no Outlook, para revisão humana (default)
# true  -> ENVIA o e-mail à operadora
#
# O default é rascunho porque o envio é irreversível e externo, e a caixa de
# e-mail de teste ainda não foi confirmada (pendência Q20). A V2 determina que
# "a notificação deve ser encaminhada por e-mail" — ligue em produção, depois
# de validar em homologação.
#
# ⚠️ Não há limite de notificações por execução (decisão de 2026-08-06). Se a
# causa da reprovação for NOSSA — mês de referência errado, Anexo 5
# desatualizado, tabela de tarifas vencida — todas as operadoras recebem um
# e-mail indevido de uma vez. Com esta chave em `false`, tudo para no rascunho.
NOTIFICAR_OPERADORA_ENVIAR=false

# Nome EXATO da conta no painel de pastas do Outlook — não é o e-mail de login.
# Valor real usado pelo Projeto 1: detrafTBRA.br@telefonica.com
OUTLOOK_ACCOUNT=

# Pasta de onde o robô lê os e-mails. Precisa existir; o robô não a cria.
OUTLOOK_DETRAF_DESPESAS_FOLDER=Detraf Despesas

# Subpasta para onde os e-mails já capturados são movidos. Criada se faltar.
OUTLOOK_PROCESSADOS_FOLDER=PROCESSADOS

# Pasta local dos anexos. Se vazio, usa DIRETORIO_ENTRADA.
OUTLOOK_DEST_ROOT=

# Tentativas de download por anexo antes de marcar erro.
OUTLOOK_MAX_RETRY=3

# Dia do mês a partir do qual o RPA 1 varre a caixa. **Dia 5 por decisão do
# GP/dev em 2026-08-05** (fecha a Q1): é o que a V1 registrava ("varredura diária
# após o dia 05"); a V2 removeu a regra e não pôs nada no lugar. Ajustável aqui
# se a área cliente definir outra data.
DETRAF_DIA_LIBERACAO=5


# ===========================================================================
# RPA 2 — validação e apuração
# ===========================================================================
# Os Detrafs das operadoras vêm de CAMINHO_OPERADORAS (acima). Aqui só a
# árvore da expectativa Vivo, que é outra.
CAMINHO_EXPECTATIVA_DETRAF=arquivos/Expectativa

# DIRETORIO_BASE_CONTESTACAO foi REMOVIDA (2026-08-04): a base de contestação é a
# tabela `tbl_rpa_log_detraf_despesa_contestacao`, não uma planilha. É o que a V2
# já pedia: "Não é necessário gerar o arquivo, mas usar a lógica e popular a
# tabela".

# ---------------------------------------------------------------------------
# 🔴 AS TRÊS LISTAS ABAIXO, VAZIAS, FAZEM O ROBÔ NÃO PROCESSAR NADA — E
#    TERMINAR COM SUCESSO
#
# Todas são usadas como `any(sub in nome for sub in LISTA)`. Com a lista vazia,
# `any(...)` é False, e o filtro rejeita tudo. Nenhum erro, nenhum aviso: a
# execução termina bem tendo processado zero arquivos.
#
# O `verificar_ambiente.py` acusa isso desde 2026-08-06 — rode-o antes.
# ---------------------------------------------------------------------------

# Substring que o nome do arquivo de expectativa deve conter.
#
# 🔴 É `_D`, e NÃO `_D_`. A V2 diz `_D_`, e essa foi a escolha até 2026-08-07 —
# até os arquivos reais chegarem: eles se chamam
# `DETRAF_FINAL_VIVO_202603_N_ALGAR_SMP_VIVO_D.csv`, terminam em `_D.csv`, e
# NENHUM dos quatro casava com `_D_`. Os projetos de origem usavam `_D`, e
# estavam certos.
#
# A falha era muda: `_preparar_arquivos_expectativa` devolvia lista vazia, o
# robô registrava "nenhum arquivo de expectativa encontrado" como AVISO e seguia.
# O batimento então compara o Detraf com o nada, e termina com sucesso.
EXPECTATIVA_SUBSTRING=_D

# Pastas onde os arquivos de expectativa ficam, separadas por vírgula.
#
# ⚠️ MVNO e "Detraf TRP" entraram em 2026-08-10, com a captação por SFTP: as
# quatro pastas passam a ser baixadas E LIDAS. Isso muda o escopo do batimento —
# as linhas de MVNO e TRP entram na comparação e podem virar contestação.
PASTAS_EXPECTATIVAS=Vivo,TLF,MVNO,Detraf TRP

# ---------------------------------------------------------------------------
# 🔴 AS DUAS DE BAIXO SÃO OPOSTAS, E AS DUAS SÃO OBRIGATÓRIAS
#
# A validação RENOMEIA o que aprovou acrescentando `_EXP`
# (`renomear_arquivos_processados`), e o batimento só lê o que TEM `_EXP`.
# Errar uma quebra o par, e as duas falham em silêncio:
#
#   ARQUIVOS_VALIDADOS vazia  -> o batimento pula TODO arquivo;
#   IGNORAR_ARQUIVOS sem _EXP -> a validação reprocessa o que já validou, e o
#                                arquivo vira `X_EXP_EXP.csv`. O histórico não
#                                protege: ele indexa pelo caminho completo, que
#                                muda justamente no rename.
#
# Os valores abaixo são os que os Projetos 2 e 3 usavam em execução real
# (adaptados: os projetos de origem usavam `_ENV`; aqui é `_EXP`).
# ---------------------------------------------------------------------------
IGNORAR_ARQUIVOS=_BK,_ERRO,_EXP
ARQUIVOS_VALIDADOS=_EXP

# Nome fantasia da Vivo no Anexo 5, separado por vírgula se houver mais de um.
# Vazio, usa "Vivo,Telefônica".
#
# É a lista com que a 2ª coluna do Detraf é validada ("deve estar preenchida com
# uma das EOTs da Vivo"). Até 2026-08-04 estava embutida no código, em dois
# lugares — acrescentar um nome exigia editar o fonte.
NOME_FANTASIA_VIVO=

# CABECARIO_PLANILHA foi REMOVIDA (2026-08-04): era o cabeçalho do .xlsx
# Base_Contestação, que deixou de ser gerado.


# ===========================================================================
# RPA 3 — contestação, AGI e Encontro de Contas
# ===========================================================================
# Raiz "...\Operadoras", que contém {operadora}\{ano}\{aaaamm}\...
CAMINHO_OPERADORAS=arquivos/Operadoras

# Controle de numeração de carta: "...\Correspondências Enviadas\CT\{ano}".
# O próximo número sai do maior encontrado nessa pasta, mais 1.
#
# Não pode haver duplicação: se o último número não puder ser identificado — a
# pasta não existe, não pode ser lida, ou não tem nenhuma carta reconhecível —
# o robô ACUSA O ERRO em vez de assumir um valor.
#
# ⚠️ É PRÉ-REQUISITO DA HU-14: sem esta variável a carta não é gerada. Vazia, o
# robô não cai num diretório qualquer — ele diz que a variável não foi configurada.
CAMINHO_CONTROLE_CT=arquivos/CT

# Número que INICIA a sequência de cartas. Deixe VAZIO em operação normal.
#
# Só é usado quando a pasta de controle existe e está sem nenhuma carta — o caso
# legítimo da virada de ano, em que a pasta do ano novo nasce vazia. Sem esta
# variável, esse caso vira erro. Assim o bootstrap de uma sequência é sempre um
# ato deliberado, nunca um default silencioso.
CT_NUMERO_INICIAL=

# Contatos das operadoras para o e-mail da HU-15 — CSV `operadora;emails`.
#
# PONTE DA PENDÊNCIA Q16 (decidida em 2026-08-05). A V2 (¶136) manda buscar os
# destinatários "na tabela de contatos do WebFat", mas não diz qual tabela nem
# quais colunas, e nenhum projeto de origem chegou a consultá-la. Até a resposta
# vir, os contatos saem deste arquivo:
#
#     operadora;para;cc
#     CLARO;contestacao@claro.com.br,fiscal@claro.com.br;gestor@claro.com.br
#     TIM;interconexao@tim.com.br;
#     *;;atacado@exemplo.com.br
#
# A linha `*` é a CÓPIA FIXA: entra em Cc de todos os envios. O formato veio do
# e-mail real do processo (print embutido no .docx), que tem dois destinatários,
# dois em cópia, e um endereço em cópia que não é da operadora.
#
# Linha em branco e comentário (#) são ignorados; a busca ignora caixa e espaços.
# O formato antigo de uma coluna só (`operadora;emails`) continua valendo.
#
# ⚠️ COM ESTE ARQUIVO PREENCHIDO E PERMITIR_ENVIO_EMAIL=true, O ROBÔ ENVIA
# E-MAIL DE VERDADE PARA AS OPERADORAS. Vazio, a HU-15 recusa o envio.
CAMINHO_CONTATOS_OPERADORAS=

# Nomes das subpastas da estrutura de rede.
SUBPASTA_AGI=AGI
SUBPASTA_CONTESTACOES=Contestações
SUBPASTA_DETRAFS_RECEBIDOS=Detrafs Recebidos
SUBPASTA_DETRAFS_ENVIADOS=Detrafs Enviados

# CAMINHO_MODELO_CARTA e CAMINHO_MASCARA_CONT_PROC foram REMOVIDAS (2026-08-04):
# estavam declaradas e nenhum módulo as lia. Sugeriam que a HU-14 dependia de um
# modelo .docx externo — não depende: a carta é montada do zero com python-docx.


# ===========================================================================
# Comum
# ===========================================================================
# Onde o histórico anti-reprocessamento é gravado.
DIRETORIO_HISTORICO_ARQUIVOS=arquivos/historico

# JSON que liga cada arquivo baixado ao e-mail de origem. Gerado pelo RPA 1 e
# consumido pelo RPA 2 para responder à operadora — é o acoplamento real entre
# os dois robôs, e não está descrito na V2.
#
# OS DOIS RPAs PRECISAM APONTAR PARA O MESMO ARQUIVO. Se o RPA 2 não o
# encontrar, ele registra "nenhum e-mail de origem encontrado" por arquivo e
# NENHUMA operadora é notificada — sem erro visível.
#
# A busca é pelo NOME do arquivo, não pelo caminho: o arquivo muda de lugar
# entre os dois robôs (do diretório de entrada para a pasta da operadora).
#
# Se vazio, usa DIRETORIO_ENTRADA\_rastreamento.json.
RASTREAMENTO_ARQUIVO_PATH=arquivos/Entrada/_rastreamento.json


# ===========================================================================
# RPA 3 — Épico 5 (carga no AGI) e HU-15 (e-mail de contestação)
# ===========================================================================
# --- Kill-switches ---------------------------------------------------------
# Os dois têm efeito externo e irreversível. Default `false`: com eles
# desligados, o fluxo roda inteiro, decide tudo e registra no log — só não age
# para fora. Ligue apenas depois de validar em homologação.
#
# PERMITIR_UPLOAD_AGI é o mais crítico: NÃO existe ambiente de teste do AGI
# (pendência Q20). Sem ele, a única forma de exercitar o fluxo é contra produção.
PERMITIR_ENVIO_EMAIL=false
PERMITIR_UPLOAD_AGI=false

# --- AGI (Portal Triad) ----------------------------------------------------
# ⚠️ USUÁRIO E SENHA NÃO ENTRAM AQUI. São lidos de variável de ambiente da
# máquina: RPA_DETRAF_DESPESA_AGI_USER e RPA_DETRAF_DESPESA_AGI_PASSWORD.
# O .env do Projeto 7 vinha com os dois preenchidos — esse padrão não é herdado.

# Executável do AGI — o `portal_air_vivo.exe` do Portal AIR da Triad.
#
# ⚠️ NÃO é o `adl.exe`, que fica no `runtime/` ao lado dele. O texto antigo do
# preflight mandava apontar para o `adl.exe`, e estava errado.
#
# Caminho relativo é ancorado em `unificado/`, e não no diretório de onde o robô
# foi lançado — então o valor abaixo funciona em qualquer máquina que tenha o
# aplicativo em `unificado/aplicacao_agi/` (pasta ignorada pelo git: 50 MB de
# binário de terceiro não entram no repositório).
#
# Na VM dos Projetos 6 e 7 o aplicativo estava fora da árvore, e o valor era o
# absoluto: C:\RPA\Dtraf\aplicacao_agi\Portal AIR\portal_air_vivo.exe
DIRETORIO_AGI=aplicacao_agi/Portal AIR/portal_air_vivo.exe

# Ambiente do AGI: `producao` ou `homologacao`.
#
# O Portal AIR abre os dois — ver as duas páginas em
# `aplicacao_agi/Portal AIR/br/com/triad/portal/pages/`. Até 2026-08-06 o robô
# clicava sempre no botão de produção, e a imagem do de homologação estava
# capturada e sem uso.
#
# ⚠️ Isto toca a pendência Q20 ("não existe ambiente de teste do AGI"): existe um
# AGI de homologação. O que continua em aberto é se ele tem dado de Despesa
# utilizável e se a credencial de produção vale nele — pergunta para a área.
AGI_AMBIENTE=producao

# Host/IP do AGI que aparece no TÍTULO dos diálogos nativos de upload/download.
# É como o robô encontra a janela; errado, ele espera um diálogo que nunca casa.
#
# O robô usa o do `AGI_AMBIENTE` acima. Os dois valores saem das próprias
# páginas do portal: produção `10.238.6.120:7010/Agi/`, homologação
# `10.129.178.159:7010/Agi/`.
AGI_JANELA_HOST_PRODUCAO=10.238.6.120
AGI_JANELA_HOST_HOMOLOGACAO=10.129.178.159

# Forma antiga, sem ambiente — a dos `.env` dos Projetos 6 e 7. Continua aceita
# como reserva, quando nenhuma das duas acima estiver preenchida.
AGI_JANELA_HOST=

# Onde salvar os prints de evidência do upload.
#
# ⚠️ NÃO é requisito da V2 — o documento não fala em evidência, print ou
# screenshot em lugar nenhum. A citação veio dos comentários do Projeto 7. O que
# a V2 exige como confirmação de carga é gravar `carga_agi` no banco.
DIRETORIO_EVIDENCIAS=arquivos/Evidencias


# ===========================================================================
# RPA 3 — HU-20: verificação do Relatório de Receitas e Despesas
# ===========================================================================
# ⚠️ A própria V2 pede confirmação de que esta HU deve existir ("trata-se de uma
# dupla checagem, conferir com o solicitante se vale a pena mantê-la") —
# pendência Q7. Ela está migrada, mas atrás do kill-switch abaixo.

# Se `true`, o robô ABRE o AGI para baixar o relatório; se `false` (default), a
# verificação roda sobre um relatório já baixado.
#
# A HU-20 é leitura e não escreve nada no AGI — mas abre o aplicativo e faz login
# em PRODUÇÃO, e não há ambiente de teste (Q20). Separado do PERMITIR_UPLOAD_AGI
# de propósito: dá para conferir sem liberar a carga, que é o que altera dado.
PERMITIR_ACESSO_AGI=false

# --- SFTP do ClickHub (RPA 2, etapa `expectativa`) --------------------------
# De onde a expectativa Vivo vem desde 2026-08-10. Antes disso os arquivos `_D`
# apareciam na pasta por fora do repositório (ICT, outra demanda).
#
# 🔴 USUÁRIO E SENHA NÃO FICAM AQUI. São variáveis de ambiente da MÁQUINA, como
# as do AGI:
#     CLICKHUB_SFTP_USER
#     CLICKHUB_SFTP_PASSWORD
#
# Host e porta não são segredo e podem ficar no arquivo.
CLICKHUB_SFTP_HOST=
CLICKHUB_SFTP_PORT=22

# Kill-switch do download. Desligado (o padrão) o robô NÃO conecta e a etapa
# segue com o que já estiver na pasta — que é o modo de teste. O `--dry-run`
# também o desarma.
#
# Para testar a etapa inteira sem rede e sem credencial:
#     main.py --etapa expectativa --de-pasta Insumos/Expectativa
PERMITIR_DOWNLOAD_SFTP=false


# ---------------------------------------------------------------------------
# Parada interativa entre etapas — SÓ PARA HOMOLOGAÇÃO
#
# Ao fim de cada etapa, abre uma caixa mostrando o que ela produziu e espera a
# confirmação para seguir. Tem botão de Cancelar (aborta a execução, com código
# de saída 2) e de Abrir pasta.
#
# 🔴 A caixa ESPERA INDEFINIDAMENTE. Num robô desassistido isso trava o
# processo. Por isso ela exige QUATRO condições ao mesmo tempo:
#   1. ENV=dev          — em produção nunca para
#   2. esta variável    — estar em dev não basta
#   3. sessão gráfica   — tarefa agendada em sessão 0 não tem desktop, e segue
#   4. fora do pytest   — uma suíte que abre diálogo trava o CI
#
# Na homologação, prefira o argumento `--pausar`: ele liga só naquela execução
# e não fica ligado por engano.
# ---------------------------------------------------------------------------
PAUSA_ENTRE_ETAPAS=false

# Onde o CSV exportado do AGI é gravado. Vazio, usa {RAIZ_LOGS}/relatorio_agi.
DIRETORIO_RELATORIO_AGI=

# Onde o .xlsx de divergências entre o AGI e o Encontro de Contas é gravado.
# Vazio, usa {RAIZ_LOGS}/inconsistencias.
#
# Fica junto do log porque é a mesma natureza: registro do que o robô viu, para
# alguém conferir depois — e herda a organização por host e a retenção.
DIRETORIO_INCONSISTENCIAS=

# Diferença em reais a partir da qual a operadora é considerada divergente.
#
# ⚠️ O valor veio do Projeto 6, com um TODO admitindo que o limiar OFICIAL não
# foi confirmado com a área cliente.
TOLERANCIA_VERIFICACAO=0.01
