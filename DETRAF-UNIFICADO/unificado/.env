# ===========================================================================
# 🔴 ESTE ARQUIVO CONTÉM SEGREDOS — NÃO VERSIONAR, NÃO COPIAR, NÃO ANEXAR
# ===========================================================================
#
# Consolidado em 2026-08-06 a partir dos `.env` dos sete projetos de origem,
# que traziam os valores reais e nunca tinham sido reunidos.
#
# O `.gitignore` foi corrigido na mesma data — antes disso `.env` NÃO era
# ignorado, e este arquivo teria ido para o histórico do git no primeiro
# `git add`. Se você criou um `.env` aqui antes de 2026-08-06, confira o
# histórico do repositório.
#
# ---------------------------------------------------------------------------
# 🔴 A CREDENCIAL DO AGI ABAIXO ESTÁ PENDENTE DE ROTAÇÃO (risco R20)
#
# Ela veio preenchida nos `.env` dos Projetos 6 e 7 — e a comparação por
# impressão digital confirmou que é a MESMA nos dois. Circulou fora do
# controle de versão.
#
# Autorização para usar o AGI (concedida em 2026-08-06) não é autorização para
# usar ESTA credencial. Rotacione antes da primeira execução contra o AGI, e
# substitua o valor aqui.
# ---------------------------------------------------------------------------

# ===========================================================================
# Ambiente
# ===========================================================================
# `dev` usa SQLite; `prod` usa o MySQL abaixo. Cada robô pode ter o seu, com
# sufixo: ENV_RPA1, ENV_RPA2, ENV_RPA3 — o específico vence o geral.
ENV=dev

LOG_LEVEL=INFO
LOG_RETENCAO=90 days
RAIZ_LOGS=

# Vazio = mês corrente. AAAAMM. O robô processa sempre o mês ANTERIOR a este.
# Na homologação, prefira `--referencia AAAAMM`: ele recebe o mês de TRÁFEGO e
# faz a conta sozinho.
DEBUG_ANO_MES_ATUAL=
COMPETENCIA=

# Parada interativa entre etapas. Só age com ENV=dev e em sessão gráfica.
# Prefira o argumento `--pausar`, que liga só naquela execução.
PAUSA_ENTRE_ETAPAS=false


# ===========================================================================
# Banco WebFat
# ===========================================================================
# ⚠️ Os projetos de origem DIVERGEM sobre qual é o banco:
#
#   P2, P3              10.124.66.79  ->  base `webfat`
#   P6, P7              10.124.66.79  ->  base `rpa`  (+ 10.124.66.77 webfat)
#   print do Workbench  10.126.70.170 ->  base `webfat`
#
# Adotado o do P2/P3 — são os projetos que de fato leem e escrevem as cinco
# tabelas `tbl_*` que o código unificado usa. A divergência foi para o
# encaminhamento ao DBA.
HOST_BD_RPA=10.124.66.77
PORT_BD_RPA=3306
DATABASE_RPA=webfat
USUARIO_BD=btime_prod
SENHA_BD=1oFo8fSO7fAPZhyx

# SQLite usado quando ENV=dev. Gere com `espelhar_banco.py` (cópia do banco
# real) ou `preparar_banco_dev.py` (dados de 2025 dos projetos de origem).
CAMINHO_SQLITE=banco_de_dados/TABELAS_DETRAF_espelho.db
CAMINHO_SQLITE_DEV=


# ===========================================================================
# Pastas — estrutura de HOMOLOGAÇÃO
# ===========================================================================
# ⚠️ Os caminhos dos projetos de origem eram de máquina de desenvolvedor
# (`C:\Users\btime\Desktop\...`) ou da VM (`C:\RPA\Dtraf\...`). Nenhum serve
# como está: os de produção são os compartilhamentos Lagoa, e eles não estão
# documentados em lugar nenhum.
#
# Abaixo vai a estrutura de homologação isolada. Para produção, substitua pelos
# caminhos Lagoa — e confira com `verificar_ambiente.py`, que testa a permissão
# de ESCRITA de verdade, criando e apagando um arquivo.

CAMINHO_OPERADORAS=arquivos/Operadoras
CAMINHO_EXPECTATIVA_DETRAF=arquivos/Expectativa
DIRETORIO_ENTRADA=arquivos/Entrada
DIRETORIO_NAO_IDENTIFICADOS=arquivos/_NAO_IDENTIFICADOS
# Onde o RPA 1 põe o que REPROVOU na validação. Outra coisa que a de cima: lá o
# arquivo está íntegro e falta cadastro nosso; aqui o arquivo é que está errado.
# Precisa ficar fora de CAMINHO_OPERADORAS — se ficasse dentro, o RPA 2 acharia
# o reprovado e responderia à operadora uma segunda vez.
DIRETORIO_QUARENTENA=arquivos/_QUARENTENA

# Área de trabalho do RPA 2: ele copia o insumo para cá, escreve na cópia e
# devolve só os artefatos. Preservada por mês; limpa pelo resetar_homologacao.py.
DIRETORIO_TEMP=arquivos/_TEMP

# Onde a validação ENTREGA os artefatos (_ENV, _ERRO, _BK, _RECUSADO.md), e de
# onde o batimento os lê. As pastas de entrada só têm insumo.
DIRETORIO_SAIDA_VALIDACAO=arquivos/_SAIDA
DIRETORIO_HISTORICO_ARQUIVOS=arquivos/historico
RASTREAMENTO_ARQUIVO_PATH=arquivos/Entrada/_rastreamento.json

# ⚠️ A numeração CT é a pasta mais sensível da lista: ela guarda a sequência
# GLOBAL de números de carta. Apontada para o compartilhamento real, cada
# rodada de teste consome números de verdade — e eles não voltam.
CAMINHO_CONTROLE_CT=arquivos/CT
CT_NUMERO_INICIAL=1

# Contatos das operadoras para a HU-15 (CSV `operadora;para;cc`).
# ⚠️ Com este arquivo preenchido E `PERMITIR_ENVIO_EMAIL=true`, o robô envia de
# verdade. O modelo tem endereços fictícios — troque antes de ligar o switch.
CAMINHO_CONTATOS_OPERADORAS=configuracao/contatos-operadoras.csv

# Corpo do e-mail de recusa à operadora (HU-04), mandado pelo RPA 1 quando o
# arquivo não passa na validação da captura.
#
# O P2 apontava um arquivo que não veio no pacote; este é um modelo genérico,
# escrito em 2026-08-06. O texto é para ser revisado pela área antes de ligar o
# NOTIFICAR_OPERADORA_ENVIAR — o arquivo INTEIRO vira o corpo do e-mail.
CAMINHO_TEMPLATE_EMAIL_DETRAF_INVALIDO=configuracao/email-detraf-invalido.txt

# Nomes das subpastas na árvore das operadoras.
SUBPASTA_AGI=AGI
SUBPASTA_CONTESTACOES=Contestações
SUBPASTA_DETRAFS_RECEBIDOS=Detrafs Recebidos
SUBPASTA_DETRAFS_ENVIADOS=Detrafs Enviados


# ===========================================================================
# Seleção de arquivos
# ===========================================================================
# 🔴 AS DUAS LISTAS ABAIXO SÃO OPOSTAS, E AS DUAS SÃO OBRIGATÓRIAS.
#
# A validação RENOMEIA o que aprovou acrescentando `_EXP`; o batimento só lê o
# que tem `_EXP`. Uma delas errada quebra o par, e as duas falham em silêncio:
#
#   ARQUIVOS_VALIDADOS vazia  -> o batimento pula TODO arquivo e termina com
#                                sucesso tendo processado nada.
#   IGNORAR_ARQUIVOS sem _EXP -> a validação reprocessa o que já validou, e o
#                                arquivo vira `X_EXP_EXP.csv`. O histórico não
#                                protege: ele indexa pelo caminho completo, que
#                                muda no rename.
ARQUIVOS_VALIDADOS=_EXP
IGNORAR_ARQUIVOS=_BK,_ERRO,_EXP

# Substring que o nome do arquivo de expectativa deve conter.
# ⚠️ A V2 diz `_D_`; os projetos de origem usavam `_D`, que é mais permissivo
# (aceita um arquivo terminado em `_D.csv`). Mantido o da V2.
EXPECTATIVA_SUBSTRING=_D
# ⚠️ MVNO e "Detraf TRP" entraram em 2026-08-10, com a captação por SFTP: as
# quatro pastas passam a ser baixadas E LIDAS. Isso muda o escopo do batimento —
# as linhas de MVNO e TRP entram na comparação e podem virar contestação.
PASTAS_EXPECTATIVAS=Vivo,TLF,MVNO,Detraf TRP

EXTENSOES_CSV=csv,txt
EXTENSOES_EXCEL=xlsx,xls,ods

NOME_FANTASIA_VIVO=Vivo,Telefônica


# ===========================================================================
# Outlook (RPA 1 e RPA 2)
# ===========================================================================
# Não tem senha: usa o perfil da sessão do Windows. Precisa do Outlook Desktop
# CLASSIC aberto — o "Novo Outlook" do Windows 11 não expõe COM.
<<<<<<< Updated upstream
OUTLOOK_ACCOUNT= detrafTBRA
=======
OUTLOOK_ACCOUNT=detrafTBRA
>>>>>>> Stashed changes
OUTLOOK_DETRAF_DESPESAS_FOLDER=Detraf Despesas
OUTLOOK_PROCESSADOS_FOLDER=PROCESSADOS
OUTLOOK_DEST_ROOT=
OUTLOOK_MAX_RETRY=3

# Dia do mês a partir do qual o RPA 1 varre a caixa (decisão do GP/dev).
DETRAF_DIA_LIBERACAO=5


# ===========================================================================
# AGI (RPA 3)
# ===========================================================================
# 🔴 A credencial abaixo é a que precisa ser ROTACIONADA (R20). Ver o topo.
RPA_DETRAF_DESPESA_AGI_USER=TBR00841
RPA_DETRAF_DESPESA_AGI_PASSWORD=gL9652ZXRmAqal4wS3Tj*0!hK@Vv

# Relativo: ancorado em `unificado/`, não no diretório de onde o robô foi
# lançado. O aplicativo (Portal AIR da Triad) está em `unificado/aplicacao_agi/`,
# que é ignorada pelo git — cada máquina tem a sua cópia no mesmo lugar.
# Na VM dos Projetos 6 e 7 era: C:\RPA\Dtraf\aplicacao_agi\Portal AIR\portal_air_vivo.exe
DIRETORIO_AGI=aplicacao_agi/Portal AIR/portal_air_vivo.exe

# Ambiente do AGI: `producao` ou `homologacao`. O portal abre os dois — ver
# `aplicacao_agi/Portal AIR/br/com/triad/portal/pages/`.
AGI_AMBIENTE=producao

# Host do AGI de cada ambiente. Entra na REGEX do título do diálogo nativo de
# upload/download; o robô escolhe o do `AGI_AMBIENTE` acima. Errado, a HU-17/18
# ou a HU-20 falha DEPOIS de abrir o AGI e logar — o pedaço caro do fluxo.
AGI_JANELA_HOST_PRODUCAO=10.238.6.120
AGI_JANELA_HOST_HOMOLOGACAO=10.129.178.159

DIRETORIO_EVIDENCIAS=arquivos/Evidencias
DIRETORIO_RELATORIO_AGI=
DIRETORIO_INCONSISTENCIAS=

# Diferença em reais a partir da qual a HU-20 considera divergência.
TOLERANCIA_VERIFICACAO=0.01


# ===========================================================================
# Efeitos externos — TODOS desligados por padrão
# ===========================================================================
# Com eles desligados o fluxo roda inteiro, gera todos os arquivos e registra o
# que faria — só não age para fora. `--dry-run` força os quatro para `false`
# naquela execução, independentemente do que estiver aqui.
#
# Aceitam sufixo por robô: PERMITIR_ACESSO_AGI_RPA3=true liga só no RPA 3.
NOTIFICAR_OPERADORA_ENVIAR=false
PERMITIR_ENVIO_EMAIL=false
PERMITIR_UPLOAD_AGI=True
PERMITIR_ACESSO_AGI=false

# --- SFTP do ClickHub (RPA 2, etapa `expectativa`) --------------------------
# De onde a expectativa Vivo vem desde 2026-08-10. Antes disso os arquivos `_D`
# apareciam na pasta por fora do repositório (ICT, outra demanda).
#
# 🔴 USUÁRIO E SENHA NÃO FICAM AQUI. São variáveis de ambiente da MÁQUINA, como
# as do AGI:
#     CLICKHUB_SFTP_USER
#     CLICKHUB_SFTP_PASSWORD
#
# Host e porta não são segredo e podem ficar no arquivo.
CLICKHUB_SFTP_HOST=
CLICKHUB_SFTP_PORT=22

# Kill-switch do download. Desligado (o padrão) o robô NÃO conecta e a etapa
# segue com o que já estiver na pasta — que é o modo de teste. O `--dry-run`
# também o desarma.
#
# Para testar a etapa inteira sem rede e sem credencial:
#     main.py --etapa expectativa --de-pasta Insumos/Expectativa
PERMITIR_DOWNLOAD_SFTP=True

