# Pasta local onde os anexos baixados do Outlook são processados/lidos.
# Se DIRETORIO_ENTRADA não for informado ao rodar sem Outlook (uso standalone),
# o robô lista os arquivos direto dessa pasta.
DIRETORIO_ENTRADA=C:\Entrada

# Raiz onde os arquivos são salvos, na estrutura {DIRETORIO_SAIDA}\{operadora}\{ano}\{aaaamm}.
# Em produção deve apontar para o caminho de rede correto (ex.: \\lagoa\...).
DIRETORIO_SAIDA=C:\Saida

# Competência de referência (AAAAMM). Opcional — se vazio, usa o mês atual.
# O robô sempre processa o MÊS ANTERIOR a este valor (ex.: 202606 -> processa 202605).
COMPETENCIA=202606

# Extensões de arquivo aceitas (sem ponto, separadas por vírgula).
EXTENSOES_CSV=csv
EXTENSOES_EXCEL=xlsx,xls,ods

# ---------------------------------------------------------------------------
# Banco de dados WebFat (Anexo 5 / log de despesas) — ver
# src/models/repository/repositorio_tabelas.py
# ---------------------------------------------------------------------------

# ENV=dev  -> conecta no SQLite local (CAMINHO_SQLITE).
# ENV=prod -> conecta no MySQL (HOST_BD_RPA/PORT_BD_RPA/DATABASE_RPA/USUARIO_BD/SENHA_BD).
ENV=dev

# Caminho do arquivo SQLite usado quando ENV=dev. Esse arquivo NÃO é
# versionado (está no .gitignore) — copie-o manualmente para essa pasta
# antes de rodar com ENV=dev.
CAMINHO_SQLITE=banco_de_dados\TABELAS_DETRAF.db

# Credenciais do MySQL, usadas somente quando ENV=prod. Deixe em branco em dev.
HOST_BD_RPA=
PORT_BD_RPA=
DATABASE_RPA=
USUARIO_BD=
SENHA_BD=

# ---------------------------------------------------------------------------
# Outlook Desktop Classic (HU-01) — ver src/services/outlook_service.py e
# src/controllers/outlook_controller.py. Requer Outlook Classic instalado e
# com perfil configurado (não funciona com o "Novo Outlook" do Windows 11).
# ---------------------------------------------------------------------------

# OBRIGATÓRIO. Nome EXATO da conta/arquivo de dados como aparece no painel de
# pastas do Outlook (a pasta de topo, irmã da Inbox) — NÃO é necessariamente
# o e-mail de login, é o nome exibido na árvore de pastas.
# Para testar localmente, troque para sua conta/PST de teste — não precisa
# ser a caixa de produção.
OUTLOOK_ACCOUNT=detrafTBRA.br@telefonica.com

# Nome da pasta (de topo, dentro da conta acima) de onde o robô lê os
# e-mails de Detraf. Precisa existir — o robô só lê, não cria essa pasta.
OUTLOOK_DETRAF_DESPESAS_FOLDER=Detraf Despesas

# Nome da subpasta (dentro da pasta acima) para onde e-mails já capturados
# são movidos. Criada automaticamente pelo robô se não existir.
OUTLOOK_PROCESSADOS_FOLDER=PROCESSADOS

# Pasta local onde os anexos baixados do Outlook são salvos antes do
# processamento. OPCIONAL — se vazio, usa o valor de DIRETORIO_ENTRADA.
OUTLOOK_DEST_ROOT=

# Tentativas de download por anexo antes de desistir e marcar erro.
OUTLOOK_MAX_RETRY=3

# Dia do mês a partir do qual o robô passa a processar e-mails (regra de
# negócio: "só processar após o dia 5"). Para testar antes do dia 5, use 1.
DETRAF_DIA_LIBERACAO=5

# Caminho do arquivo JSON de rastreamento (vincula cada arquivo baixado ao
# e-mail de origem, para permitir localizar/responder o e-mail depois).
# OPCIONAL — se vazio, usa DIRETORIO_ENTRADA\_rastreamento.json.
RASTREAMENTO_ARQUIVO_PATH=
