# .env.example — variáveis de ambiente do Épico 4 (AI/01-Arquitetura.md §5)
# Copie para `.env` e ajuste. NUNCA versione o `.env` real (só este exemplo).

# Ambiente: dev (SQLite local) | prod (MySQL WebFat)
ENV=dev

# Período de referência override (AAAAMM) — usado nos testes para determinismo.
# Vazio => usa o mês atual - 1.
DEBUG_ANO_MES_ATUAL=

# Extensões aceitas pelo toolkit de arquivos (sem ponto, separadas por vírgula).
EXTENSOES_CSV=csv,txt
EXTENSOES_EXCEL=xlsx,xls

# --- Banco de dados ---------------------------------------------------------
# Caminho do SQLite em dev (substitui hardcode — T-003). Vazio => default local
# em data/dev/TABELAS_DETRAF.db.
CAMINHO_SQLITE=

# Credenciais MySQL (apenas ENV=prod).
HOST_BD_RPA=
PORT_BD_RPA=
DATABASE_RPA=
USUARIO_BD=
SENHA_BD=

# --- Caminhos de I/O do Épico 4 --------------------------------------------
# Raiz "...\Operadoras" que contém {operadora}\{ano}\{aaaamm}\...
CAMINHO_OPERADORAS=

# Controle de numeração de carta "...\Correspondências Enviadas\CT\{ano}".
CAMINHO_CONTROLE_CT=

# Nomes das subpastas de saída (normalmente os defaults abaixo).
SUBPASTA_AGI=AGI
SUBPASTA_CONTESTACOES=Contestações
SUBPASTA_DETRAFS_RECEBIDOS=Detrafs Recebidos
SUBPASTA_DETRAFS_ENVIADOS=Detrafs Enviados

# --- Insumos externos BLOQUEADOS (ver TODO/bloqueios.md) --------------------
# Modelo de carta por operadora (D-3) e máscara CONT_PROC / Descritor (D-4/D-5).
CAMINHO_MODELO_CARTA=
CAMINHO_MASCARA_CONT_PROC=

# Diretório do JSON de histórico de reprocessamento.
DIRETORIO_HISTORICO_ARQUIVOS=
